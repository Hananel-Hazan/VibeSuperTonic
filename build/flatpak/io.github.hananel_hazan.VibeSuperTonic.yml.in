# The Flatpak manifest. A TEMPLATE: build/pack-flatpak.sh fills in the two
# @TARBALL_*@ lines with the Linux tarball it was given, by path for a local
# build or by release URL for Flathub, always with its SHA-256.
#
# It builds nothing of ours from source. It installs the tree pack-tar.sh
# composed and asserted, as the AppImage and the snap do, so the eleven
# assertions apply to this package too. The one thing it compiles is the export
# ffmpeg (the first module), which the tarball deliberately does not carry.
#
# THE LAYOUT IS A CONTRACT WITH CODE. The tree goes to /app/lib/vibesupertonic,
# and FlatpakPeer in Core recognises a deployment by that path: the host-side
# hotkey client finds the daemon's socket from it, and DaemonLaunch starts the
# daemon at /app/lib/vibesupertonic/vibesupertonicd. Move it and both break,
# silently. FlatpakPeer.InstallSuffix and SandboxDir are the other end.
#
# No --filesystem=home and no host config access. The hotkeys and the Speech
# Dispatcher module are the desktop's configuration, written once by
# sandbox-setup.sh on the host. See that file.

id: io.github.hananel_hazan.VibeSuperTonic
runtime: org.freedesktop.Platform
runtime-version: '26.08'
sdk: org.freedesktop.Sdk
command: vibesupertonic

finish-args:
  # The window, on either display server. X11 only when Wayland is absent.
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  # The voice.
  - --socket=pulseaudio
  # The first-run model download, from Hugging Face.
  - --share=network
  # GPU inference. The optional CUDA pack is not offered inside the sandbox.
  - --device=dri
  # The tray icon.
  - --talk-name=org.kde.StatusNotifierWatcher

modules:
  # THE EXPORT ENCODER: MP3, AAC and FLAC. The sandbox cannot see the host's
  # ffmpeg, and the runtime ships ffmpeg's libraries but not the `ffmpeg`
  # program, so this builds a minimal LGPL one (build/build-ffmpeg.sh, the same
  # recipe the snap and the from-source manifest use) into
  # /app/lib/vibesupertonic/ffmpeg, where FfmpegDetector looks. Sources pinned:
  # ffmpeg by commit, LAME by SHA-256, both equal to the script's pins
  # (check-ffmpeg-pins.sh). The script itself is the RECIPE line, filled in by
  # pack-flatpak.sh: the tarball does not carry it.
  - name: ffmpeg-export
    buildsystem: simple
    build-commands:
      - bash build-ffmpeg.sh --ffmpeg-src ffmpeg-src --lame-src lame-src --work "$PWD/work"
          --out /app/lib/vibesupertonic/ffmpeg
    sources:
      - type: git
        url: https://github.com/FFmpeg/FFmpeg.git
        tag: n8.1.3
        commit: 1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7
        dest: ffmpeg-src
      - type: archive
        url: https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
        sha256: ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e
        dest: lame-src
      - type: file
        path: @FFMPEG_RECIPE@

  - name: vibesupertonic
    buildsystem: simple
    # Install the tarball's bytes as they are. flatpak-builder otherwise strips
    # every ELF under /app and splits out debug info, and the binaries the
    # tarball's assertions checked would not be the ones that ship.
    build-options:
      no-debuginfo: true
      strip: false
    build-commands:
      - install -d /app/lib/vibesupertonic /app/bin
      - cp -a . /app/lib/vibesupertonic/
      # A wrapper, not a symlink: the window resolves its own directory, and a
      # script is certain to leave it the real one.
      - |
        cat > /app/bin/vibesupertonic <<'EOF'
        #!/bin/sh
        exec /app/lib/vibesupertonic/vibesupertonic-ui "$@"
        EOF
      - chmod 755 /app/bin/vibesupertonic
      # For `flatpak run --command=sandbox-setup.sh <id>`, which prints the host
      # command for this install.
      - ln -s ../lib/vibesupertonic/sandbox-setup.sh /app/bin/sandbox-setup.sh
      - install -Dm644 desktop/io.github.hananel_hazan.VibeSuperTonic.desktop
          /app/share/applications/io.github.hananel_hazan.VibeSuperTonic.desktop
      - install -Dm644 desktop/io.github.hananel_hazan.VibeSuperTonic.metainfo.xml
          /app/share/metainfo/io.github.hananel_hazan.VibeSuperTonic.metainfo.xml
      - install -Dm644 desktop/io.github.hananel_hazan.VibeSuperTonic.png
          /app/share/icons/hicolor/256x256/apps/io.github.hananel_hazan.VibeSuperTonic.png
    sources:
      - type: archive
        @TARBALL_LOCATION@
        sha256: @TARBALL_SHA256@
