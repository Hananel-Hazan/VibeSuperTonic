    <Project Path="src/VibeSuperTonic.Engine/VibeSuperTonic.Engine.csproj" />
    <Project Path="src/VibeSuperTonic.Launcher/VibeSuperTonic.Launcher.csproj" />
    <Project Path="src/VibeSuperTonic.TestHarness/VibeSuperTonic.TestHarness.csproj" />
  </Folder>
</Solution>
