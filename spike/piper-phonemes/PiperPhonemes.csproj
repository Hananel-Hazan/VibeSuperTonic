<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase P1 of docs/PIPER-PLAN.md - the go/no-go. Diffs our P/Invoked
    espeak-ng phonemisation against piper's, over the committed corpus.

    NO PACKAGE REFERENCES, deliberately. The whole claim of this phase is that
    phonemisation costs one shared library and no managed dependency; a wrapper
    package here would make that claim untestable. The project reference below
    is to our own code and does not weaken it.

    SINCE P3 THIS RUNS AGAINST THE PHONEMISER THAT SHIPS. It used to hold its
    own implementation, which meant a green parity run measured a copy that was
    free to drift from the product. Espeak.cs is now the negative control and
    nothing else: Sabotage.None delegates to EspeakPhonemizer, and every other
    case re-implements the one step it removes.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport source generation requires it; no unsafe code is written here. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>vst-piper-phonemes</AssemblyName>
    <RootNamespace>VibeSuperTonic.Spike.PiperPhonemes</RootNamespace>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeSuperTonic.Piper\VibeSuperTonic.Piper.csproj" />
  </ItemGroup>

</Project>
