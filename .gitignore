# Build outputs
[Bb]in/
[Oo]bj/
*.user

# Distribution composition area
dist/

# Downloaded ONNX models — too large for git, fetched on first run
*.onnx
models/

# ...but src/VibeSuperTonic.Core/Models/ is SOURCE (Manifest.cs,
# ModelDownloader.cs), and core.ignorecase is true on this repo, so the rule
# above matches it too. Re-included explicitly — without this the files are
# silently untracked and any host that consumes Core fails to build.
!src/**/Models/

# IDE
.vs/
.idea/
*.swp

# Logs
corehost-trace.log
*.log

# Upstream Supertonic source — vendored copy of Helper.cs already lives in
# src/VibeSuperTonic.Engine/Synth/SupertonicSdk.cs with attribution; the rest
# of the upstream tree is fetched at build time, not tracked.
external/

# espeak-ng build output — a clone, a cmake tree and the composed espeak/
# payload. Generated by build/build-espeak.sh, consumed by build/pack-tar.sh.
build/espeak-out/
